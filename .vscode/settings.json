{
    // Vscode editor settings
    "editor.inlayHints.enabled": "on",
    "editor.minimap.enabled": false,
    "editor.formatOnSave": true,
    // Doxygen Settings
    "doxdocgen.c.triggerSequence": "/**",
    "doxdocgen.file.copyrightTag": [
        "@copyright Techperts AG."
    ],
    "doxdocgen.generic.dateFormat": "MM-DD-YYYY",
    "doxdocgen.generic.dateTemplate": "@date {date}",
    "doxdocgen.file.fileOrder": [
        "custom",
        "copyright",
        "date",
        "brief"
    ],
    // Language settings
    "clangd.arguments": [
        "--query-driver=C:\\msys64\\mingw64\\**\\*"
    ],
    "cmake.configureOnOpen": false,
    "[cpp]": {
        "editor.formatOnSave": true
    },
    "[cmake]": {
        "editor.defaultFormatter": "cheshirekow.cmake-format"
    },
    // C/C++ settings
    // Disable intellisense engine
    "C_Cpp.intelliSenseEngine": "default",
    // Keep code analysis enabled
    "C_Cpp.codeAnalysis.clangTidy.enabled": true,
    "C_Cpp.codeAnalysis.runAutomatically": true,
    "C_Cpp.clang_format_style": "file",
    // Exclude directories from analysis
    "C_Cpp.codeAnalysis.exclude": {
        "**/build/**": true
    },
    // "clangd.onConfigChanged": "restart",
    // "clangd.onConfigChanged.forceEnable": true,
    "C_Cpp.default.enableConfigurationSquiggles": true
}