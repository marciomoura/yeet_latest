            },
            "options": {
                "cwd": "${workspaceFolder}/build-host/bin/Release/"
            },
            "problemMatcher": [],
            "detail": "Runs the yeet_testing unit tests"
        },
        {
            "label": "Build All Tests",
            "type": "shell",
            "command": "ninja",
            "args": [
                "-C",
                "build-host",
                "yeet_test",
                "yeet_control_tests",
                "yeet_application_sfc_tests",
                "yeet_application_sfc_integration_tests",
                "yeet_testing_tests"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "Builds all test executables"
        },
        {
