                "kind": "test",
                "isDefault": false
            },
            "options": {
                "cwd": "${workspaceFolder}/build-host/bin/Release/"
            },
            "problemMatcher": [],
            "detail": "Runs the yeet_application_sfc_integration unit tests"
        },
        {
            "label": "yeet_testing_tests",
