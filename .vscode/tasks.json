{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Initialize Python venv",
            "type": "shell",
            "command": "python -m venv ${workspaceFolder}/build/venv; ${workspaceFolder}\\build\\venv\\bin\\Activate.ps1; $env:PIP_INDEX_URL='https://pypi.org/simple'; python -m pip install -r ${workspaceFolder}\\python_requirements.txt",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            }
        },
        {
            "label": "Yeet unit-tests",
            "type": "shell",
            "command": "./yeet_test.exe",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "options": {
                "cwd": "${workspaceFolder}/build-host/bin/Release/"
            },
            "problemMatcher": [],
            "detail": "Runs the executable"
        },
        {
            "label": "yeet_control_tests",
            "type": "shell",
            "command": "./yeet_control_tests.exe",
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "options": {
                "cwd": "${workspaceFolder}/build-host/bin/Release/"
            },
            "problemMatcher": [],
            "detail": "Runs the yeet_control unit tests"
        },
        {
            "label": "yeet_application_sfc_tests",
