        },
        {
            "label": "Build Core Yeet Library",
            "type": "shell",
            "command": "ninja",
            "args": [
                "-C",
                "build-host",
                "yeet"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "Builds the core yeet library"
        },
        {
            "label": "Build All Libraries",
            "type": "shell",
            "command": "ninja",
            "args": [
                "-C",
                "build-host",
                "yeet",
                "yeet_control",
                "yeet_application_sfc",
                "yeet_application_sfc_integration",
                "yeet_testing"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "Builds all core libraries"
        },
        {
            "label": "Run All Tests",
            "type": "shell",
            "command": "ctest",
            "args": [
                "--test-dir",
                "build-host",
                "--output-on-failure",
                "--verbose"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "Runs all tests using CTest"
        },
        {
            "label": "Run SFC Tests Only",
            "type": "shell",
            "command": "ctest",
            "args": [
                "--test-dir",
                "build-host",
                "--output-on-failure",
                "-R",
                "sfc"
            ],
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "Runs only SFC-related tests using CTest"
        },
        {
            "label": "Clean Build",
            "type": "shell",
            "command": "ninja",
            "args": [
                "-C",
                "build-host",
                "clean"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "Cleans the build directory"
        },
        {
            "label": "Full Build (All Targets)",
            "type": "shell",
            "command": "ninja",
            "args": [
                "-C",
                "build-host"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "Builds all targets in the project"
        },
        {
            "label": "Yeet plotting (dec=10)",
            "type": "shell",
            "command": "python.exe",
            "args": [
                "${workspaceFolder}/software/yeet/tools/plot_sampler_data.py",
                "${workspaceFolder}/build-host/bin/Release/",
                "${workspaceFolder}/build-host/bin/Release/",
                "--move=${workspaceFolder}/build-host/bin/Release/testing_outputs/",
                "--decimate=10"
            ],
            "problemMatcher": [],
            "detail": "Runs the Python script after the executable"
        },
        {
            "label": "Yeet plotting (dec=1)",
            "type": "shell",
            "command": "python.exe",
            "args": [
                "${workspaceFolder}/software/yeet/tools/plot_sampler_data.py",
                "${workspaceFolder}/build-host/bin/Release/",
                "${workspaceFolder}/build-host/bin/Release/",
                "--move=${workspaceFolder}/build-host/bin/Release/testing_outputs/",
                "--decimate=1"
            ],
            "problemMatcher": [],
            "detail": "Runs the Python script after the executable"
        },
