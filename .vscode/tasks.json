            "command": "ninja",
            "args": [
                "-C",
                "build-host",
                "yeet_control"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
