{
    "version": "2.0.0",
    "inputs": [
        {
            "id": "embeddedBoard",
            "type": "pickString",
            "description": "Select target board",
            "options": [
                "disc1",
                "cn"
            ],
            "default": "zg"
        },
        {
            "id": "embeddedSide",
            "type": "pickString",
            "description": "Select controller side",
            "options": [
                "grid",
                "machine"
            ],
            "default": "grid"
        },
        {
            "id": "buildConfiguration",
            "type": "pickString",
            "description": "Select build configuration",
            "options": [
                "debug",
                "release"
            ],
            "default": "release"
        },
        {
            "id": "buildConfigurationCapitalized",
            "type": "pickString",
            "description": "Select build configuration (for path)",
            "options": [
                "Debug",
                "Release"
            ],
            "default": "Release"
        }
    ],
    "tasks": [
        {
            "label": "Initialize Python venv",
            "type": "shell",
            "command": "python -m venv ${workspaceFolder}/build/venv; ${workspaceFolder}\\build\\venv\\bin\\Activate.ps1; $env:PIP_INDEX_URL='https://pypi.org/simple'; python -m pip install -r ${workspaceFolder}\\python_requirements.txt",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            }
        },
        {
            "label": "Run All Tests",
            "type": "shell",
            "command": "ctest",
            "args": [
                "--test-dir",
                "build-host",
                "--output-on-failure",
                "--verbose"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "Runs all tests using CTest"
        },
        {
            "label": "Run SFC Tests Only",
            "type": "shell",
            "command": "ctest",
            "args": [
                "--test-dir",
                "build-host",
                "--output-on-failure",
                "-R",
                "sfc"
            ],
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "Runs only SFC-related tests using CTest"
        },
        {
            "label": "Clean Build",
            "type": "shell",
            "command": "ninja",
            "args": [
                "-C",
                "build-host",
                "clean"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "Cleans the build directory"
        },
        {
            "label": "Full Build (All Targets)",
            "type": "shell",
            "command": "ninja",
            "args": [
                "-C",
                "build-host"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "Builds all targets in the project"
        },
        {
            "label": "Yeet plotting (dec=10)",
            "type": "shell",
            "command": "python.exe",
            "args": [
                "${workspaceFolder}/software/yeet/tools/plot_sampler_data.py",
                "${workspaceFolder}/build-host/bin/Release/",
                "${workspaceFolder}/build-host/bin/Release/",
                "--move=${workspaceFolder}/build-host/bin/Release/testing_outputs/",
                "--decimate=10"
            ],
            "problemMatcher": [],
            "detail": "Runs the Python script after the executable"
        },
        {
            "label": "Yeet plotting (dec=1)",
            "type": "shell",
            "command": "python.exe",
            "args": [
                "${workspaceFolder}/software/yeet/tools/plot_sampler_data.py",
                "${workspaceFolder}/build-host/bin/Release/",
                "${workspaceFolder}/build-host/bin/Release/",
                "--move=${workspaceFolder}/build-host/bin/Release/testing_outputs/",
                "--decimate=1"
            ],
            "problemMatcher": [],
            "detail": "Runs the Python script after the executable"
        },
        {
            "label": "Configure Embedded Target",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--preset=embedded-${input:embeddedBoard}-${input:embeddedSide}"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "Configure CMake for selected embedded target (board + side)"
        },
        {
            "label": "Build Embedded Target",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset=embedded-${input:embeddedBoard}-${input:embeddedSide}-${input:buildConfiguration}"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "Build selected embedded target with chosen configuration"
        },
        {
            "label": "Flash Embedded Target",
            "type": "shell",
            "command": "C:/ST/STM32CubeCLT_1.19.0/STM32CubeProgrammer/bin/STM32_Programmer_CLI.exe",
            "args": [
                "-c",
                "port=SWD",
                "-w",
                "${workspaceFolder}/build-embedded-${input:embeddedBoard}-${input:embeddedSide}/bin/${input:buildConfigurationCapitalized}/yeet_embedded_app_${input:embeddedSide}.elf",
                "-v",
                "-rst"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "problemMatcher": [],
            "detail": "Flash selected embedded target to STM32 via ST-Link"
        },
        {
            "label": "Build & Flash Embedded Target",
            "dependsOn": [
                "Configure Embedded Target",
                "Build Embedded Target",
                "Flash Embedded Target"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "problemMatcher": [],
            "detail": "Complete workflow: Configure, build, and flash selected embedded target"
        }
    ]
}