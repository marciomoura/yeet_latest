{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Initialize Python venv",
            "type": "shell",
            "command": "python -m venv ${workspaceFolder}/build/venv; ${workspaceFolder}\\build\\venv\\bin\\Activate.ps1; $env:PIP_INDEX_URL='https://pypi.org/simple'; python -m pip install -r ${workspaceFolder}\\python_requirements.txt",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            }
        },
        {
            "label": "Yeet unit-tests",
            "type": "shell",
            "command": "./yeet_test.exe",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "options": {
                "cwd": "${workspaceFolder}/build/bin/"
            },
            "problemMatcher": [],
            "detail": "Runs the executable"
        },
        {
            "label": "yeet_control_tests",
            "type": "shell",
            "command": "./yeet_control_tests.exe",
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "options": {
                "cwd": "${workspaceFolder}/build/bin/"
            },
            "problemMatcher": [],
            "detail": "Runs the yeet_control unit tests"
        },
        {
            "label": "yeet_application_sfc_tests",
            "type": "shell",
            "command": "./yeet_application_sfc_tests.exe",
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "options": {
                "cwd": "${workspaceFolder}/build/bin/"
            },
            "problemMatcher": [],
            "detail": "Runs the yeet_application_sfc unit tests"
        },
        {
            "label": "yeet_application_mpc_integration_tests",
            "type": "shell",
            "command": "./yeet_application_mpc_integration_tests.exe",
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "options": {
                "cwd": "${workspaceFolder}/build/bin/"
            },
            "problemMatcher": [],
            "detail": "Runs the yeet_application_mpc integration tests"
        },
        {
            "label": "yeet_application_sfc_integration_tests",
            "type": "shell",
            "command": "./yeet_application_sfc_integration_tests.exe",
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "options": {
                "cwd": "${workspaceFolder}/build/bin/"
            },
            "problemMatcher": [],
            "detail": "Runs the yeet_application_sfc_integration unit tests"
        },
        {
            "label": "yeet_testing_tests",
            "type": "shell",
            "command": "./yeet_testing_tests.exe",
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "options": {
                "cwd": "${workspaceFolder}/build/bin/"
            },
            "problemMatcher": [],
            "detail": "Runs the yeet_testing unit tests"
        },
        {
            "label": "Build All Tests",
            "type": "shell",
            "command": "ninja",
            "args": [
                "-C",
                "build",
                "yeet_test",
                "yeet_control_tests",
                "yeet_application_sfc_tests",
                "yeet_application_sfc_integration_tests",
                "yeet_testing_tests"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "Builds all test executables"
        },
        {
            "label": "Build SFC Library",
            "type": "shell",
            "command": "ninja",
            "args": [
                "-C",
                "build",
                "yeet_application_sfc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "Builds the yeet_application_sfc library"
        },
        {
            "label": "Build SFC Integration Library",
            "type": "shell",
            "command": "ninja",
            "args": [
                "-C",
                "build",
                "yeet_application_sfc_integration"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "Builds the yeet_application_sfc_integration library"
        },
        {
            "label": "Build Yeet Control Library",
            "type": "shell",
            "command": "ninja",
            "args": [
                "-C",
                "build",
                "yeet_control"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "Builds the yeet_control library"
        },
        {
            "label": "Build Core Yeet Library",
            "type": "shell",
            "command": "ninja",
            "args": [
                "-C",
                "build",
                "yeet"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "Builds the core yeet library"
        },
        {
            "label": "Build All Libraries",
            "type": "shell",
            "command": "ninja",
            "args": [
                "-C",
                "build",
                "yeet",
                "yeet_control",
                "yeet_application_sfc",
                "yeet_application_sfc_integration",
                "yeet_testing"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "Builds all core libraries"
        },
        {
            "label": "Run All Tests",
            "type": "shell",
            "command": "ctest",
            "args": [
                "--test-dir",
                "build",
                "--output-on-failure",
                "--verbose"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "Runs all tests using CTest"
        },
        {
            "label": "Run SFC Tests Only",
            "type": "shell",
            "command": "ctest",
            "args": [
                "--test-dir",
                "build",
                "--output-on-failure",
                "-R",
                "sfc"
            ],
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "Runs only SFC-related tests using CTest"
        },
        {
            "label": "Clean Build",
            "type": "shell",
            "command": "ninja",
            "args": [
                "-C",
                "build",
                "clean"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "Cleans the build directory"
        },
        {
            "label": "Full Build (All Targets)",
            "type": "shell",
            "command": "ninja",
            "args": [
                "-C",
                "build"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "Builds all targets in the project"
        },
        {
            "label": "Yeet plotting (dec=10)",
            "type": "shell",
            "command": "python.exe",
            "args": [
                "${workspaceFolder}/software/yeet/tools/plot_sampler_data.py",
                "${workspaceFolder}/build/bin/",
                "${workspaceFolder}/build/bin/",
                "--move=${workspaceFolder}/build/bin/testing_outputs/",
                "--decimate=10"
            ],
            "problemMatcher": [],
            "detail": "Runs the Python script after the executable"
        },
        {
            "label": "Yeet plotting (dec=1)",
            "type": "shell",
            "command": "python.exe",
            "args": [
                "${workspaceFolder}/software/yeet/tools/plot_sampler_data.py",
                "${workspaceFolder}/build/bin/",
                "${workspaceFolder}/build/bin/",
                "--move=${workspaceFolder}/build/bin/testing_outputs/",
                "--decimate=1"
            ],
            "problemMatcher": [],
            "detail": "Runs the Python script after the executable"
        },
        {
            "label": "Flash Embedded Target (Debug)",
            "type": "shell",
            "command": "C:/ST/STM32CubeCLT_1.19.0/STM32CubeProgrammer/bin/STM32_Programmer_CLI.exe",
            "args": [
                "-c",
                "port=SWD",
                "-w",
                "${workspaceFolder}/build-embedded/bin/yeet_embedded_app.elf",
                "-v",
                "-rst"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "problemMatcher": [],
            "detail": "Flash the debug build to STM32F407G-DISC1 via ST-Link"
        },
        {
            "label": "Flash Embedded Target (Release)",
            "type": "shell",
            "command": "C:/ST/STM32CubeCLT_1.19.0/STM32CubeProgrammer/bin/STM32_Programmer_CLI.exe",
            "args": [
                "-c",
                "port=SWD",
                "-w",
                "${workspaceFolder}/build-embedded-release/bin/yeet_embedded_app.elf",
                "-v",
                "-rst"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "test",
                "isDefault": false
            },
            "problemMatcher": [],
            "detail": "Flash the release build to STM32F407G-DISC1 via ST-Link"
        }
    ]
}