// JLink script to flash STM32F407ZG CN Machine-Side Debug build
// Reset and halt the target
r
halt
// Erase flash
erase
// Load the ELF file
loadfile ../build-embedded-cn-machine/bin/Debug/yeet_embedded_app_machine.elf
// Verify programming
verifybin ../build-embedded-cn-machine/bin/Debug/yeet_embedded_app_machine.elf 0x08000000
// Reset and run
r
go
// Exit JLink
qc
