            component "core/C function" load_characteristic {
                arb_defs = "/*Begin code section*/

/*End code section*/"
                global_variables = "real in2;real in3;real in4;real in5;real in6;"
                init_fnc = "/*Begin code section*/

/*End code section*/"
                input_terminals_dimensions = "inherit"
                input_terminals_feedthrough = "True"
                input_terminals_show_labels = "False"
                output_fnc = "/*Begin code section*/
/*
 * Load characteristic model for a 52 MVA, 3000 RPM Gas Turbine Generator startup.
 * This function calculates the resistive load torque (breakaway, friction, windage)
 * that the LCI starter system must overcome.
 *
 * SYSTEM SPECIFICATIONS:
 * - Generator Full Rating: 52 MVA (full GT-Gen combined rating)
 * - LCI Soft-Starter Rating: 2.95 MVA (for starting)
 * - Synchronous Speed: 3000 RPM (2-pole, 50 Hz machine)
 * - Moment of Inertia: Jm = 4741.83 kg*m^2 (H = 4.5 seconds)
 *
 * All torque values are in Newton-meters (Nm).
 * Input \'in\' is the current speed in RPM.
 * Output \'out\' is the resistive torque in Nm.
 */

// --- Define Parameters for the 52 MVA, 3000 RPM System ---

// Calculate rated torque from power rating
// T_rated = P_rated / omega_mech
// omega_mech = 2*pi*n/60 = 2*pi*3000/60 = 314.16 rad/s
// T_rated = 52,000,000 VA / 314.16 rad/s = 165,509 Nm

double rated_power_VA = 2.95e6;                                          // Generator full rating [VA]
double rated_speed_rpm = 3000.0;                                         // Synchronous speed [RPM]
double omega_mech_rated = 2.0 * 3.14159265359 * rated_speed_rpm / 60.0;  // 314.16 rad/s
double rated_torque_Nm = rated_power_VA / omega_mech_rated;              // ~165,509 Nm

// Breakaway torque (Nm) to overcome static friction at standstill.
// For large gas turbines, this is typically 15-25% of rated torque.
// Using conservative 20% for this 52 MVA system.
double breakaway_torque = 0.20 * rated_torque_Nm;  // ~33,102 Nm

// Coefficient for friction and windage losses that scale with the square of speed.
// At rated speed, windage losses for GT-Gen systems are typically 0.3-0.8% of rated power.
// Using 0.5% as typical for modern aeroderivative gas turbines.
// Torque at rated speed due to windage: T_windage = 0.005 * T_rated
double torque_at_rated_speed = 0.005 * rated_torque_Nm;  // ~827 Nm
double speed_squared_inverse = 1.0 / (rated_speed_rpm * rated_speed_rpm);
double k_windage = torque_at_rated_speed * speed_squared_inverse;  // ~9.19e-5

// The speed at which the gas turbine becomes self-sustaining and starter disengages.
// For gas turbines, this is typically 60-70% of rated speed.
// Using 65% as typical for industrial GT soft-starters.
double starter_disengage_rpm = 0.65 * rated_speed_rpm;  // 1950 RPM

// Gas turbine operating phases (for reference/comments):
// - Creep speed:           150 RPM  (5% of rated) - oil circulation
// - Purge acceleration:    600 RPM  (20% of rated) - chamber ventilation
// - Ignition:             1650 RPM  (55% of rated) - fuel ignition
// - Self-sustaining:      1950 RPM  (65% of rated) - GT carries own load
// - Assist acceleration:  2850 RPM  (95% of rated) - final acceleration
// - Synchronization:      3000 RPM  (100% of rated) - grid connection

// --- Calculation ---

// Pre-calculate squared input for efficiency
double in2 = in * in;

// Condition 1: At or near zero speed (e.g., < 10 RPM).
// The load is dominated by the constant breakaway torque.
// This represents static friction in bearings, seals, and compressor blade loading.
if (in >= 0 && in < 10) {
    out = breakaway_torque;
}

// Condition 2: From low speed up to starter disengagement (self-sustaining speed).
// The load is a combination of:
//   - Base friction torque (decreases slightly from breakaway as surfaces separate)
//   - Speed-dependent windage losses (proportional to N^2)
// Model: Resistive Torque = Base_Friction + k_windage * N^2
else if (in >= 10 && in <= starter_disengage_rpm) {
    // Base friction reduces to ~80% of breakaway once in motion (Coulomb friction model)
    double running_friction = 0.80 * breakaway_torque;
    out = running_friction + k_windage * in2;
}

// Condition 3: Above starter disengagement speed (GT is self-sustaining).
// The gas turbine combustion is now providing more power than it consumes.
// The starter system is no longer needed and would typically disengage.
// We output a large number to indicate an out-of-bounds condition for the starter model.
else {
    out = 1e6;  // Out-of-range indicator
}

// Final assignment if your simulation environment requires it
// output_variable = out;

/*
 * NOTES FOR TYPHOON HIL INTEGRATION:
 *
 * 1. This C code can be used in a \"C Function\" block in Typhoon HIL schematic editor.
 *
 * 2. Expected torque values for 52 MVA system:
 *    - Breakaway (0-10 RPM):        ~33,102 Nm (constant)
 *    - Running friction (10+ RPM):  ~26,482 Nm (base)
 *    - Windage at 1000 RPM:         ~92 Nm (additional)
 *    - Windage at 1950 RPM (65%):   ~349 Nm (additional)
 *    - Total at 1950 RPM:           ~26,831 Nm
 *
 * 3. For comparison with 2 MVA system:
 *    - Old breakaway: 1,020 Nm  →  New: 33,102 Nm  (32.5x larger)
 *    - Old windage coeff: 8.49e-5  →  New: 9.19e-5  (similar per-unit)
 *    - Old disengage: 1800 RPM  →  New: 1950 RPM  (higher self-sustaining speed)
 *
 * 4. The torque profile is realistic for:
 *    - Large industrial gas turbines (10-60 MW class)
 *    - Combined gas turbine + generator rotor inertia (H = 4.5s)
 *    - Modern aeroderivative or heavy-duty industrial GT technology
 *
 * 5. LCI Soft-Starter capability check:
 *    - LCI Rating: 2.95 MVA at 1980 V
 *    - Maximum LCI torque ≈ 2.95e6 / 314.16 ≈ 9,390 Nm
 *    - Breakaway torque (33,102 Nm) is 3.5x larger than LCI steady-state capability!
 *    - This is NORMAL - the LCI accelerates slowly using pulsed current at low speed
 *    - Actual peak current capability may be 2-3x rated for short durations
 *
 * 6. Integration with mechanical system:
 *    - Connect \'out\' (resistive torque) to the negative input of torque summer
 *    - Motor torque (from LCI) = positive input
 *    - Net torque = Motor torque - Load torque
 *    - Net torque drives the mechanical integrator: dω/dt = T_net / Jm
 *    - Where Jm = 4741.83 kg*m^2
 */
/*End code section*/"
                output_terminals_dimensions = "inherit"
                output_terminals_feedthrough = "True"
                output_terminals_show_labels = "False"
                update_fnc = "/*Begin code section*/

/*End code section*/"
