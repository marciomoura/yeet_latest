# clangd configuration for STM32F407G-DISC1 embedded target

CompileFlags:
    # Use the embedded build directory
    CompilationDatabase: ../../build-embedded
    
    # Add ARM-specific flags that might be missing
    Add:
        - -DSTM32F407xx
        - -DUSE_HAL_DRIVER
        - -mcpu=cortex-m4
        - -mthumb
        - -mfpu=fpv4-sp-d16
        - -mfloat-abi=hard

Index:
    Background: Build

Hover:
    ShowAKA: Yes

Diagnostics:
    UnusedIncludes: None
    MissingIncludes: Strict
    # Suppress some common embedded warnings
    Suppress:
        - implicit-function-declaration
