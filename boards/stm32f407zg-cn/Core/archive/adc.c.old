/********************************************************************
 *AI.c - Analog Input Driver (Hardware Layer Only)                  *
 *                                                                   *
 *Reads AD7606 ADC data and provides basic utilities                *
 *Application control logic removed - see archive/ directory         *
 ********************************************************************/
#include <math.h>

#include "AD7606.h"
#include "stm32f4xx_gpio.h"

/********************************************************************************
 *AD7606                                                                         *
 *AD7606���Խ���8·�����ѹ��16λ�������ȡ�RANGEΪ�ߵ�ƽ���뷶Χ��10V������Ϊ��5V��*
 *AD7606����������ģ��ͨ����Ϊ����ͬʱ������CONVSTA/B��������һ�飬��ͬʱ������	*
 *AD7606��ARM֮��ʹ��16λ�����������ӣ�CS���������������ߴ��ڸ���״̬���½�������*
 *�������������״̬��BUSY��Ϊ�͵�ƽ���һ��RD�½��ض�ȡV1�����ݣ���һ��RD�½��� *
 *��ȡV2�������������£�ֱ����ȡV8��                                             *
 *********************************************************************************
 *���ŷ���                                                                       *
 *BUSY: PC13��RST��PF10��RANGE��PF9��CONVSTA��PF6��CONVSTB��PF7��                *
 ********************************************************************************/
#define WRITE_READ_ADDR  0x800
#define Bank1_SRAM2_ADDR ((uint32_t)0x64000000)
#define ADC_CHANNNEL     0x08

/********************************************************************************
 *Delay_Nop                                                                      *
 *��ʱ����                                                                       *
 ********************************************************************************/
void Delay_Nop(unsigned int x)
{
    unsigned int i;
    for (i = 0; i < x; i++);
}

/********************************************************************************
 *AD7606_Init_Pin                                                                *
 *��ʼ��AD7606������š�                                                         *
 *BUSY: PC13��RST��PF10��RANGE��PF9��CONVSTA��PF6��CONVSTB��PF7��                *
 ********************************************************************************/
void AD7606_Init_Pin(void)
{
    GPIO_InitTypeDef GPIO_InitStructure;

    RCC_AHB1PeriphClockCmd(RCC_AHB1Periph_GPIOD, ENABLE);

    // BUSY
    GPIO_InitStructure.GPIO_Mode = GPIO_Mode_IN;
    GPIO_InitStructure.GPIO_PuPd = GPIO_PuPd_NOPULL;
    GPIO_InitStructure.GPIO_Pin = GPIO_Pin_13;
    GPIO_Init(GPIOD, &GPIO_InitStructure);

    // RST
    RCC_AHB1PeriphClockCmd(RCC_AHB1Periph_GPIOF, ENABLE);

    GPIO_InitStructure.GPIO_Pin = GPIO_Pin_10;
    GPIO_InitStructure.GPIO_Mode = GPIO_Mode_OUT;
    GPIO_InitStructure.GPIO_OType = GPIO_OType_PP;
    GPIO_InitStructure.GPIO_PuPd = GPIO_PuPd_UP;
    GPIO_InitStructure.GPIO_Speed = GPIO_Speed_50MHz;
    GPIO_Init(GPIOF, &GPIO_InitStructure);

    // RANGE
    GPIO_InitStructure.GPIO_Pin = GPIO_Pin_9;
    GPIO_Init(GPIOF, &GPIO_InitStructure);

    // CONVSTA
    GPIO_InitStructure.GPIO_Pin = GPIO_Pin_6;
    GPIO_Init(GPIOF, &GPIO_InitStructure);

    // CONVSTB
    GPIO_InitStructure.GPIO_Pin = GPIO_Pin_7;
    GPIO_Init(GPIOF, &GPIO_InitStructure);
}

